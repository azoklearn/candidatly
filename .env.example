# Candidatly environment. Copy to .env.local and fill in: never commit .env.local.
# lib/env.ts validates each group the first time it is used.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase: Project Settings > API Keys (local values are printed by `npx supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (jobs, Stripe webhook). Bypasses RLS.
SUPABASE_SECRET_KEY=
# Database password chosen at project creation, used by `npm run db:push`.
SUPABASE_DB_PASSWORD=
# Local Google sign-in only, see [auth.external.google] in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- API Alternance: https://api.apprentissage.beta.gouv.fr/fr/compte/profil ---
# Production token, read access to real offers. Expiry date in docs/RUNBOOK.md.
API_ALTERNANCE_KEY=
# Sandbox token, application tests only.
API_ALTERNANCE_SANDBOX_KEY=
API_ALTERNANCE_BASE_URL=https://api.apprentissage.beta.gouv.fr/api

# --- Public APIs without key ---
GEOCODING_API_BASE_URL=https://data.geopf.fr/geocodage
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr

# --- Anthropic (phase 2 and later) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_LETTER=claude-sonnet-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# --- Scheduled offer sync (Supabase Cron calls /api/cron/sync-offers, docs/RUNBOOK.md) ---
# Shared secret, at least 32 characters (openssl rand -hex 32). Same value in Supabase Vault
# under the name candidatly_cron_secret.
CRON_SECRET=

# --- Payments: Whop (docs/RUNBOOK.md, "Paiements Whop") ---
# Account API key (Whop dashboard > Developer). Without it and the webhook secret, there is no
# paywall: every student keeps full access.
WHOP_API_KEY=
# Webhook signing secret (ws_...), written to .env.local by `npm run whop:setup`.
WHOP_WEBHOOK_SECRET=
WHOP_API_BASE_URL=https://api.whop.com/api/v1
WHOP_CHECKOUT_BASE_URL=https://whop.com
# 1 turns the paywall off (set by the end-to-end tests).
BILLING_DISABLED=

# --- Monitoring (phase 5) ---
SENTRY_DSN=
