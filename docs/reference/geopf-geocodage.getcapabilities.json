{
  "info": {
    "name": "Service de géocodage public de la Géoplateforme",
    "title": "API Géoplateforme - Géocodage",
    "description": "Ce service fournit les coordonnées géographiques d'un lieu (adresse, point d'intérêt, parcelle cadastrale...) ou des lieux à partir de coordonnées géographiques.",
    "language": "Français",
    "contact": {
      "email": "geoplateforme@ign.fr"
    }
  },
  "api": {
    "name": "rest",
    "version": "1.0.0"
  },
  "operations": [
    {
      "id": "search",
      "description": "fournit les coordonnées géographiques d'un lieu (adresse, point d'intérêt, parcelle cadastrale...)",
      "url": "/search?",
      "methods": [
        "GET"
      ],
      "parameters": [
        {
          "name": "index",
          "in": "query",
          "description": "index de recherche",
          "required": false,
          "default": [
            "address"
          ],
          "schema": {
            "type": "string",
            "example": "address,parcel,poi",
            "enum": [
              "address",
              "poi",
              "parcel"
            ]
          }
        },
        {
          "name": "q",
          "in": "query",
          "description": "chaîne décrivant la localisation à rechercher",
          "required": false,
          "schema": {
            "type": "string",
            "example": "73 Avenue de Paris Saint-Mandé"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "description": "nombre maximum de candidats retournés",
          "required": false,
          "default": 10,
          "schema": {
            "type": "integer",
            "example": "5"
          }
        },
        {
          "name": "lon",
          "in": "query",
          "description": "longitude d’un localisant pour favoriser les candidats les plus proches",
          "required": false,
          "schema": {
            "type": "number",
            "example": "2.327640"
          }
        },
        {
          "name": "lat",
          "in": "query",
          "description": "latitude d’un localisant pour favoriser les candidats les plus proches",
          "required": false,
          "schema": {
            "type": "number",
            "example": "48.835187"
          }
        },
        {
          "name": "type",
          "in": "query",
          "description": "filtre pour l’index address. Il permet de filtrer par type de données adresse : numéro de maison, rue, commune, ...",
          "required": false,
          "schema": {
            "type": "string",
            "example": "municipality",
            "enum": [
              "housenumber",
              "street",
              "locality",
              "municipality"
            ]
          }
        },
        {
          "name": "postcode",
          "in": "query",
          "description": "filtre pour les index address et poi. Il permet de filtrer les résultats par code postal",
          "required": false,
          "schema": {
            "type": "string",
            "example": "94160"
          }
        },
        {
          "name": "citycode",
          "in": "query",
          "description": "filtre pour les index address et poi. Il permet de filtrer les résultats par code INSEE",
          "required": false,
          "schema": {
            "type": "string",
            "example": "94067"
          }
        },
        {
          "name": "depcode",
          "in": "query",
          "description": "filtre pour les index address et poi. Il permet de filtrer les résultats par code de département",
          "required": false,
          "schema": {
            "type": "string",
            "example": "94"
          }
        },
        {
          "name": "city",
          "in": "query",
          "description": "filtre pour les index address et poi. Il permet de filtrer par nom de commune",
          "required": false,
          "schema": {
            "type": "string",
            "example": "saint-mandé"
          }
        },
        {
          "name": "category",
          "in": "query",
          "description": "filtre pour l'index poi. Il permet de filtrer par catégorie de poi",
          "required": false,
          "schema": {
            "type": "string",
            "example": "administratif"
          }
        },
        {
          "name": "returntruegeometry",
          "in": "query",
          "description": "indique si la vraie géométrie doit être retournée",
          "required": false,
          "default": false,
          "schema": {
            "type": "boolean",
            "example": "false"
          }
        },
        {
          "name": "autocomplete",
          "in": "query",
          "description": "indique si la recherche doit être réalisée en mode auto-complétion. Pertinent uniquement pour la saisie en direct d'utilisateurs",
          "required": false,
          "default": true,
          "schema": {
            "type": "boolean",
            "example": "false"
          }
        },
        {
          "name": "departmentcode",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par code de département",
          "required": false,
          "schema": {
            "type": "string",
            "example": "94"
          }
        },
        {
          "name": "municipalitycode",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par code de commune",
          "required": false,
          "schema": {
            "type": "string",
            "example": "000"
          }
        },
        {
          "name": "oldmunicipalitycode",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par code d’ancienne commune",
          "required": false,
          "schema": {
            "type": "string",
            "example": "000"
          }
        },
        {
          "name": "districtcode",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par code d’arrondissement",
          "required": false,
          "schema": {
            "type": "string",
            "example": "105"
          }
        },
        {
          "name": "section",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par section",
          "required": false,
          "schema": {
            "type": "string",
            "example": "AC"
          }
        },
        {
          "name": "number",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par feuille",
          "required": false,
          "schema": {
            "type": "string",
            "example": "0035"
          }
        },
        {
          "name": "sheet",
          "in": "query",
          "description": "filtre pour l’index parcel. Il permet de filtrer par feuille",
          "required": false,
          "schema": {
            "type": "string",
            "example": "1"
          }
        }
      ]
    },
    {
      "id": "reverse",
      "description": "fournit des lieux (adresse, point d'intérêt, parcelle cadastrale...) à partir de coordonnées géographiques",
      "url": "/reverse?",
