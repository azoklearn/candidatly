          "schema": {
            "type": "object",
            "example": "{\"type\":\"Polygon\",\"coordinates\":[[[2.354550,48.837961],[2.354550,48.839232],[2.357211,48.839232],[2.357211,48.837961],[2.354550,48.837961]]]}"
