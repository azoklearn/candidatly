el-option","nom":"element_option","valeurs":[{"bloc":{"idSectionBloc":1654},"element":{"id":116},"cle":"option","valeur":"publique"}],"ordreElement":0}],"categories":[{"id":6,"nom":"Teasing"}]},{"id":33,"idSectionBloc":1034,"nomComposant":"hero","ordre":1,"elements":[{"id":22,"elementType":"el-text","nom":"element_texte","valeurs":[{"bloc":{"idSectionBloc":1034},"element":{"id":22},"cle":"text","valeur":"ROME 4.0 – Fiches métiers"}],"ordreElement":0},{"id":42,"elementType":"el-wysiwyg","nom":"element_wysiwyg","valeurs":[{"bloc":{"idSectionBloc":1034},"element":{"id":42},"cle":"text","valeur":"<p>Accédez aux informations vous permettant de reconstituer le contenu d’une fiche métier (ordre et niveau des compétences) référencée dans le Répertoire Opérationnel des Métiers et des Emplois (ROME).</p>"}],"ordreElement":1},{"id":69,"elementType":"el-image-a-la-une","nom":"element_image_a_la_une","valeurs":[{"cle":"image_infos","images":{"id":273,"imageS":{"id":911,"height":170,"width":163,"mimeType":"image/png","url":"/api-peio/v2/images/911/image_generique.png"},"imageM":{"id":912,"height":340,"width":326,"mimeType":"image/png","url":"/api-peio/v2/images/912/image_generique.png"},"imageL":{"id":913,"height":510,"width":490,"mimeType":"image/png","url":"/api-peio/v2/images/913/image_generique.png"},"nom":"rome.png"}}],"ordreElement":2},{"id":23,"elementType":"el-text","nom":"element_texte_2","valeurs":[{"bloc":{"idSectionBloc":1034},"element":{"id":23},"cle":"text"}],"ordreElement":3},{"id":139,"elementType":"el-text","nom":"element_texte_14","valeurs":[{"bloc":{"idSectionBloc":1034},"element":{"id":139},"cle":"text"}],"ordreElement":4}],"categories":[{"id":8,"nom":"Contribution"}],"image":{"id":231,"height":250,"width":348,"mimeType":"image/jpeg"}},{"id":3,"idSectionBloc":1035,"nomComposant":"texte-riche","customName":"Données de l'API","ordre":2,"elements":[{"id":42,"elementType":"el-wysiwyg","nom":"element_wysiwyg","valeurs":[{"bloc":{"idSectionBloc":1035},"element":{"id":42},"cle":"text","valeur":"<p>L’API «&nbsp;ROME 4.0 -&nbsp;Fiches métiers »&nbsp;permet de structurer les données au format de la fiche du <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/produits-partages/contribuer-rome\">Répertoire Opérationnel des Métiers et des Emplois</a>.</p><p>Cette API vous permet d’identifier, pour chaque fiche :</p><ul><li>Les groupes de compétences mobilisées : les compétences sont classées et ordonnées par enjeu,</li><li>Les groupes de savoirs : les savoirs sont classés et ordonnés par catégorie de savoir.</li></ul><p>Cette API s’utilise en complément de l’<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/produits-partages/catalogue/rome-4-0-metiers\">API ROME Métiers</a>.&nbsp;<br>&nbsp;</p><h4>Pourquoi utiliser cette API&nbsp;?</h4><p>En accédant à cette API, vous êtes certain de bénéficier de la dernière version de la présentation des fiches ROME à chaque appel.</p><p>Ces API sont enrichies régulièrement par des experts&nbsp;pour suivre les tendances du marché du travail.</p>"}],"ordreElement":0}],"categories":[{"id":8,"nom":"Contribution"}]},{"id":3,"idSectionBloc":1036,"nomComposant":"texte-riche","customName":"Contexte et cas d'usage","ordre":3,"elements":[{"id":42,"elementType":"el-wysiwyg","nom":"element_wysiwyg","valeurs":[{"bloc":{"idSectionBloc":1036},"element":{"id":42},"cle":"text","valeur":"<ul><li>Vous souhaitez développer votre référentiel RH en vous appuyant sur une nomenclature de qualité qui vous aide à décrire les métiers et les compétences associées.</li><li>Vous souhaitez exposer les informations relatives aux emplois en respectant la mise en forme des fiches ROME.</li></ul><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/produits-partages/contribuer-rome\">Cliquez ici pour en savoir plus sur le ROME</a></p>"}],"ordreElement":0}],"categories":[{"id":8,"nom":"Contribution"}]},{"id":3,"idSectionBloc":1037,"nomComposant":"texte-riche","customName":"Conditions d'utilisation","ordre":4,"elements":[{"id":42,"elementType":"el-wysiwyg","nom":"element_wysiwyg","valeurs":[{"bloc":{"idSectionBloc":1037},"element":{"id":42},"cle":"text","valeur":"<p><strong>Accès à l’API</strong></p><ul><li>L’API ROME 4.0 - Fiches métiers est en accès libre : utilisez-la librement en respectant les conditions mentionnées dans <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/produits-partages/documentation/conditions-dutilisation-api/licence-etalab\">la licence Etalab</a>, et en vous <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/inscription\">créant un compte</a> sur francetravail.io.</li><li>Pour en savoir plus sur l’accès aux produits sur francetravail.io, rendez-vous dans <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://francetravail.io/produits-partages/documentation/conditions-dutilisation-api\">la page dédiée de la documentation.</a></li></ul><p><strong>Étapes d’accès</strong></p><ol><li>Cliquez sur le bouton “Utiliser l’API” en haut de la page de l’API puis authentifiez-vous ou créez-vous un compte sur notre plateforme francetravail.io.</li><li>Associez l’API que vous souhaitez utiliser à l’une de vos applications dans votre espace personnel (ou créez d’abord une nouvelle application).</li><li>Grâce à la création d’un identifiant client et d’une clé secrète, vous pouvez désormais utiliser l’API.</li></ol>"}],"ordreElement":0}],"categories":[{"id":8,"nom":"Contribution"}]},{"id":3,"idSectionBloc":1038,"nomComposant":"texte-riche","customName":"Chiffre clés","ordre":5,"elements":[{"id":42,"elementType":"el-wysiwyg","nom":"element_wysiwyg","valeurs":[{"bloc":{"idSectionBloc":1038},"element":{"id":42},"cle":"text"}],"ordreElement":0}],"categories":[{"id":8,"nom":"Contribution"}]},{"id":3,"idSectionBloc":1039,"nomComposant":"texte-riche","customName":"Widget","ordre":6,"elements":[{"id":42,"elementType":"el-wysiwyg","nom":"e